{
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 6,
  "control-center-margin-right": 10,
  "control-center-margin-bottom": 10,
  "control-center-width": 400,
  "notification-window-width": 380,
  "notification-icon-size": 48,
  "notification-body-image-height": 100,
  "notification-grouping": false,
  "image-visibility": "when-available",
  "timeout": 6,
  "timeout-low": 4,
  "timeout-critical": 0,
  "transition-time": 150,
  "fit-to-screen": true,
  "hide-on-clear": false,
  "hide-on-action": true,
  "keyboard-shortcuts": true,
  "widgets": [
    "title",
    "dnd",
    "notifications",
    "mpris",
    "volume",
    "backlight",
    "buttons-grid"
  ],
  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear all"
    },
    "dnd": {
      "text": "Do not disturb"
    },
    "buttons-grid": {
      "buttons-per-row": 4,
      "actions": [
        {
          "label": "󰤨",
          "type": "toggle",
          "active": true,
          "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && nmcli radio wifi on || nmcli radio wifi off'",
          "update_command": "sh -c '[[ $(nmcli radio wifi) == \"enabled\" ]] && echo true || echo false'"
        },
        {
          "label": "󰂯",
          "type": "toggle",
          "active": true,
          "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && rfkill unblock bluetooth || rfkill block bluetooth'",
          "update_command": "sh -c 'rfkill list bluetooth | grep -q \"Soft blocked: yes\" && echo false || echo true'"
        },
        {
          "label": "󰍬",
          "type": "toggle",
          "active": true,
          "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 0 || wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 1'",
          "update_command": "sh -c 'wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED && echo false || echo true'"
        },
        {
          "label": "󰀝",
          "type": "toggle",
          "active": false,
          "command": "sh -c '[ \"$SWAYNC_TOGGLE_STATE\" = true ] && rfkill block all || rfkill unblock all'",
          "update_command": "sh -c 'rfkill list | grep -q \"Soft blocked: no\" && echo false || echo true'"
        },
        {
          "label": "󰓅",
          "type": "toggle",
          "active": false,
          "command": "sh -c '[ \"$SWAYNC_TOGGLE_STATE\" = true ] && powerprofilesctl set performance || powerprofilesctl set balanced'",
          "update_command": "sh -c '[ \"$(powerprofilesctl get)\" = performance ] && echo true || echo false'"
        },
        {
          "label": "󰑊",
          "type": "toggle",
          "command": "sh -c 'swaync-client -cp && sleep 0.3 && \"$HOME/.local/bin/record\" full'",
          "active": false,
          "update_command": "sh -c 'pgrep -x wf-recorder >/dev/null && echo true || echo false'"
        },
        {
          "label": "󰏘",
          "type": "button",
          "command": "sh -c 'swaync-client -cp && sleep 0.3 && hyprpicker -a -n'"
        },
        {
          "label": "󰖔",
          "type": "toggle",
          "active": false,
          "command": "sh -c '[ \"$SWAYNC_TOGGLE_STATE\" = true ] && (setsid hyprsunset -t 4000 >/dev/null 2>&1 &) || pkill -x hyprsunset'",
          "update_command": "sh -c 'pgrep -x hyprsunset >/dev/null && echo true || echo false'"
        },
        {
          "label": "󰅶",
          "type": "toggle",
          "active": false,
          "command": "sh -c '[ \"$SWAYNC_TOGGLE_STATE\" = true ] && pkill -x hypridle || (setsid hypridle >/dev/null 2>&1 &)'",
          "update_command": "sh -c 'pgrep -x hypridle >/dev/null && echo false || echo true'"
        },
        {
          "label": "󰹑",
          "type": "button",
          "command": "sh -c 'swaync-client -cp && sleep 0.3 && \"$HOME/.local/bin/screenshot\" region'"
        },
        {
          "label": "󰌾",
          "type": "button",
          "command": "sh -c 'swaync-client -cp && loginctl lock-session'"
        },
        {
          "label": "󰐥",
          "type": "button",
          "command": "sh -c 'swaync-client -cp && \"$HOME/.local/bin/wofi-menus\" power'"
        }
      ]
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": false
    },
    "backlight": {
      "label": "󰃟",
      "device": "intel_backlight"
    },
    "mpris": {
      "image-size": 80,
      "image-radius": 14
    }
  }
}
