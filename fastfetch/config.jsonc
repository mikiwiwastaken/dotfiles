{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "top": 2
    },
    "color": {
      "1": "38;2;203;166;247",
      "2": "38;2;137;180;250"
    }
  },
  "display": {
    "separator": " -> ",
    "color": {
      "title": "38;2;245;194;231", // Pink
      "separator": "38;2;108;112;134", // Overlay0
      "output": "38;2;205;214;244" // Text
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": " OS",
      "keyColor": "38;2;203;166;247",
      "format": "{2}"
    },
    {
      "type": "os",
      "key": "├{icon}", // Just get your distro's logo off nerdfonts.com
      "keyColor": "38;2;203;166;247"
    },
    {
      "type": "kernel",
      "key": "├",
      "keyColor": "38;2;203;166;247"
    },
    {
      "type": "packages",
      "key": "├󰏖",
      "keyColor": "38;2;203;166;247"
    },
    {
      "type": "shell",
      "key": "└",
      "keyColor": "38;2;203;166;247"
    },
    "break",
    {
      "type": "wm",
      "key": " DE/WM",
      "keyColor": "38;2;137;180;250"
    },
    {
      "type": "lm",
      "key": "├󰧨",
      "keyColor": "38;2;137;180;250"
    },
    {
      "type": "wmtheme",
      "key": "├󰉼",
      "keyColor": "38;2;137;180;250"
    },
    {
      "type": "icons",
      "key": "├󰀻",
      "keyColor": "38;2;137;180;250"
    },
    {
      "type": "wallpaper",
      "key": "├󰸉",
      "keyColor": "38;2;137;180;250"
    },
    {
      "type": "terminal",
      "key": "└",
      "keyColor": "38;2;137;180;250"
    },
    "break",
    {
      "type": "host",
      "key": "󰌢 PC",
      "keyColor": "38;2;166;227;161"
    },
    {
      "type": "cpu",
      "key": "├󰻠",
      "keyColor": "38;2;166;227;161"
    },
    {
      "type": "gpu",
      "key": "├󰍛",
      "keyColor": "38;2;166;227;161"
    },
    {
      "type": "disk",
      "key": "├",
      "keyColor": "38;2;166;227;161"
    },
    {
      "type": "memory",
      "key": "├󰑭",
      "keyColor": "38;2;166;227;161"
    },
    {
      "type": "swap",
      "key": "├󰓡",
      "keyColor": "38;2;166;227;161"
    },
    {
      "type": "display",
      "key": "├󰍹",
      "keyColor": "38;2;166;227;161"
    },
    {
      "type": "uptime",
      "key": "└󰅐",
      "keyColor": "38;2;166;227;161"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;243;139;168m󰊠 \u001b[38;2;245;194;231m󰊠 \u001b[38;2;148;226;213m󰊠 \u001b[38;2;250;179;135m󰊠  \u001b[38;2;249;226;175m󰮯 \u001b[38;2;108;112;134m• • • • • • • • • • \u001b[38;2;205;214;244m●\u001b[0m"
    }
  ]
}
